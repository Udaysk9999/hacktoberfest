# ==============================================================================
# LocalDoc AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local execution.
# NEVER commit .env to version control.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Ollama / Local Model Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Target local model tag (pending hardware benchmark confirmation)
OLLAMA_MODEL=gemma4

# Local Embedding Configuration
# Uses local sentence-transformers / huggingface embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Storage Directories (Relative to backend root or absolute)
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store
TEMP_DIR=./data/temp
